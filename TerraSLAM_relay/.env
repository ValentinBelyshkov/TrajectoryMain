# TerraSLAM_relay paths
# These paths match the Docker container paths from docker-compose.yml
# Override these when running outside Docker

PROJECTS_DIR=/opt/main/Trajectory/Database/projects
SLAM_DB=/opt/main/Trajectory/Database
YAML_PATH=/opt/main/Trajectory/Database/real.yaml

# Gateway IS this same process (system_manager on :9000). For local use it
# must resolve to loopback; for remote control from another host set this to
# the Jetson's LAN IP, e.g. http://192.168.0.1:9000
TERRASLAM_GATEWAY_URL=http://192.168.0.1:9000
